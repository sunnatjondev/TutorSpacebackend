BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_USERNAME=YOUR_BOT_USERNAME

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

WEBAPP_URL=https://YOUR_WEBAPP_DOMAIN
WEBAPP_ORIGIN=https://YOUR_WEBAPP_DOMAIN
# Local only. Railway injects PORT automatically; do not set API_PORT in production.
API_PORT=3000

# Set to 0 only for local debugging. Production should keep initData fresh.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
SUPABASE_APP_JWT_TTL_SECONDS=3600
